# Required
OPENROUTER_API_KEY=          # https://openrouter.ai/keys
MODEL_ID=                    # open-weight model slug from https://openrouter.ai/models (verify it supports tools)

# Required from phase 2 (web search)
TAVILY_API_KEY=              # https://tavily.com (free tier, no card)

# Optional
MODEL_FALLBACKS=             # comma-separated slugs tried in order if MODEL_ID errors before streaming
FAST_MODEL_ID=               # small model for background jobs such as titles
OPENROUTER_BASE_URL=         # override the API base (any OpenAI-compatible endpoint); default https://openrouter.ai/api/v1
PROVIDER_ORDER=              # comma-separated OpenRouter providers to pin (tool-calling quality varies by provider)
REASONING_EFFORT=            # low | medium | high (passed through to reasoning models)
LOG_LEVEL=info               # debug also logs full prompts and answers; silent turns logging off
LOG_FORMAT=pretty            # or json
PORT=3000
DB_PATH=./data/agent.db
